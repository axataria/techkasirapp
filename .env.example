# Server-only session pooler connection; never prefix this with NEXT_PUBLIC_.
DATABASE_URL=postgresql://techkasir_app.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
TECHKASIR_REQUIRE_POSTGRES=true
# Allowed browser origin for the local Node backend (optional).
TECHKASIR_APP_ORIGIN=https://kasirlaptoplab.web.app
# Optional: PEM certificate if your PostgreSQL provider uses another CA.
# DATABASE_CA_CERT=

# Public Edge Function URL, safe to embed in a static frontend.
NEXT_PUBLIC_TECHKASIR_API_URL=https://eumlynnylgdlscpednor.supabase.co/functions/v1/techkasir-api
